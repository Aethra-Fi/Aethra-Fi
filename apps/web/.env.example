# Copy to apps/web/.env.local
NEXT_PUBLIC_NETWORK=local            # network a new visitor sees first: local | testnet | mainnet. A local build has no toggle.
# Optional. API of the default network (otherwise built-in per network):
NEXT_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api
# Optional per-network overrides for the testnet/mainnet toggle:
NEXT_PUBLIC_API_URL_TESTNET=
NEXT_PUBLIC_API_URL_MAINNET=
NEXT_PUBLIC_RPC_URL_TESTNET=
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional overrides for the JSON-RPC endpoint used by wagmi
NEXT_PUBLIC_RPC_URL=
